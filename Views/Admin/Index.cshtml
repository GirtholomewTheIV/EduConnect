@model IEnumerable<User>

@{
    var users = Model?.ToList() ?? new List<User>();
    int admins = users.Count(u => u.Role == "Admin");
    int teachers = users.Count(u => u.Role == "Teacher");
    int parents = users.Count(u => u.Role == "Parent");
    int students = users.Count(u => u.Role == "Student");
    int active = users.Count(u => u.IsActive);
    int inactive = users.Count - active;
}

<h1>Admin Portal</h1>
<p class="lead">Manage EduConnect accounts, classes and audit records.</p>

<div class="grid stats-grid">
    <div class="card stat-card">
        <div class="stat-number">@users.Count</div>
        <div class="stat-label">Total accounts</div>
        <div class="card-caption">
            <span class="badge success">@active active</span>
            @if (inactive > 0)
            {
                <span class="badge danger">@inactive inactive</span>
            }
        </div>
    </div>
    <div class="card stat-card">
        <div class="stat-number">@teachers</div>
        <div class="stat-label">Teachers</div>
    </div>
    <div class="card stat-card">
        <div class="stat-number">@parents</div>
        <div class="stat-label">Parents</div>
    </div>
    <div class="card stat-card">
        <div class="stat-number">@students</div>
        <div class="stat-label">Students</div>
    </div>
    <div class="card stat-card">
        <div class="stat-number">@admins</div>
        <div class="stat-label">Administrators</div>
    </div>
</div>

<h2 class="section-title">Manage</h2>

<div class="grid">
    <a class="card link-card" asp-controller="Admin" asp-action="Users">
        <div class="card-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="8" r="3.5" />
                <path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6" />
                <circle cx="17" cy="9" r="2.5" />
                <path d="M17 14.5c2.6 0 4.5 1.8 4.5 4.5" />
            </svg>
        </div>
        <h2>Users</h2>
        <p class="card-caption">View system accounts and roles.</p>
    </a>
    <a class="card link-card" asp-controller="Admin" asp-action="Classes">
        <div class="card-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 21h18" />
                <path d="M5 21V10l7-5 7 5v11" />
                <path d="M10 21v-5h4v5" />
                <path d="M9 11h.01M15 11h.01" />
            </svg>
        </div>
        <h2>Classes</h2>
        <p class="card-caption">View classrooms and class teachers.</p>
    </a>
    <a class="card link-card" asp-controller="Admin" asp-action="Audit">
        <div class="card-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l8 3v6c0 4.5-3.2 8-8 9-4.8-1-8-4.5-8-9V6l8-3z" />
                <path d="M8.5 12l2.5 2.5 5-5" />
            </svg>
        </div>
        <h2>POPIA Audit</h2>
        <p class="card-caption">View access and account activity.</p>
    </a>
</div>