@model LoginViewModel

<div class="form-card">
    <h1>Login</h1>

    <form asp-action="Login" asp-route-returnUrl="@(ViewData["ReturnUrl"] as string)" method="post">
        <div asp-validation-summary="All" class="validation"></div>

        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="validation"></span>
        </div>

        <button type="submit" class="button">Sign in</button>
    </form>

    <div class="demo-box">
        <strong>Demo accounts</strong>
        <p>Admin: admin@educonnect.local / Admin123!</p>
        <p>Teacher: teacher@educonnect.local / Demo123!</p>
        <p>Parent: parent@educonnect.local / Demo123!</p>
        <p>Student: student@educonnect.local / Demo123!</p>
    </div>
</div>
