@model HomeworkViewModel

<h1>Create Homework</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="validation"></div>

    <div class="form-group">
        <label asp-for="Title"></label>
        <input asp-for="Title" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="SubjectId"></label>
        <select asp-for="SubjectId" class="form-control"
                asp-items="@(new SelectList(ViewBag.Subjects, "SubjectId", "SubjectName"))">
            <option value="">Select Subject</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="DueDate"></label>
        <input asp-for="DueDate" class="form-control" />
    </div>

    <button type="submit" class="button">Save</button>
    <a class="button secondary" asp-action="Index">Cancel</a>
</form>
