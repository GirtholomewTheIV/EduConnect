@model IEnumerable<Homework>

<div class="page-heading">
    <div>
        <h1>Homework</h1>
        <p class="lead">Upcoming assignment due dates.</p>
    </div>
    @if (User.IsInRole("Teacher"))
    {
        <a class="button" asp-action="Create">Create Homework</a>
    }
</div>
@if (TempData["Message"] is string message)
{
    <div class="card" style="margin-bottom:16px">@message</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Due Date</th>
            <th>Overdue</th>
            @if (User.IsInRole("Admin"))
{
    <th>Delete</th>
}
        </tr>
    </thead>
    <tbody>
    @foreach (Homework item in Model)
    {
        <tr>
            <td>@item.Title</td>
            <td>@item.DueDate.ToShortDateString()</td>
            <td>
    @if (item.IsOverdue)
    {
        <span style="color:#b91c1c; font-weight:600">Late</span>
    }
    else
    {
        <span>-</span>
    }
</td>@if (User.IsInRole("Admin"))
{
    <td>
        <form asp-action="Delete" asp-route-id="@item.HomeworkId" method="post"
              onsubmit="return confirm('Delete this homework?');">
            <button type="submit" class="button" style="background:#b91c1c">Delete</button>
        </form>
    </td>
}
        </tr>
    }
    </tbody>
</table>
