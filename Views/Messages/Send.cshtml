@model MessageViewModel

<h1>Send Message</h1>

<form asp-action="Send" method="post">
    <div asp-validation-summary="All" class="validation"></div>

    <div class="form-group">
        <label asp-for="ReceiverEmail"></label>
        <input asp-for="ReceiverEmail" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="MessageText"></label>
        <textarea asp-for="MessageText" class="form-control" rows="5"></textarea>
    </div>

    <button type="submit" class="button">Send</button>
    <a class="button secondary" asp-action="Index">Cancel</a>
  </form>