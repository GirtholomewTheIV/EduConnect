@model EduConnect.Models.TestMark

<div class="page-heading">
    <h1>Add Mark</h1>
    <a class="button secondary" asp-action="Index">Back to Grades</a>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>

        <div class="form-group">
            <label asp-for="StudentId">Learner</label>
            <select asp-for="StudentId" asp-items="(List<SelectListItem>)ViewBag.Students" class="form-control">
                <option value="">-- Select learner --</option>
            </select>
            <span asp-validation-for="StudentId" class="validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="SubjectId">Subject</label>
            <select asp-for="SubjectId" asp-items="(List<SelectListItem>)ViewBag.Subjects" class="form-control">
                <option value="">-- Select subject --</option>
            </select>
            <span asp-validation-for="SubjectId" class="validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="Score"></label>
            <input asp-for="Score" class="form-control" step="any" />
            <span asp-validation-for="Score" class="validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="MaxScore"></label>
            <input asp-for="MaxScore" class="form-control" step="any" />
            <span asp-validation-for="MaxScore" class="validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="AssessmentDate"></label>
            <input asp-for="AssessmentDate" class="form-control" />
            <span asp-validation-for="AssessmentDate" class="validation"></span>
        </div>

        <div class="form-group">
            <label asp-for="Notes"></label>
            <textarea asp-for="Notes" class="form-control" rows="4"
                      placeholder="Optional comments on the learner's progress"></textarea>
            <span asp-validation-for="Notes" class="validation"></span>
        </div>

        <button type="submit" class="button">Save mark</button>
    </form>
</div>