<div class="hero">
    <div>
        <h1>EduConnect</h1>
        <p>School-to-home communication and learner progress management.</p>
        <a class="button" asp-controller="Account" asp-action="Login">Sign in</a>
    </div>
</div>

<div class="grid">
    <div class="card">
        <h2>Parent Portal</h2>
        <p>View grades, attendance, notices, messages and report cards.</p>
    </div>
    <div class="card">
        <h2>Teacher Portal</h2>
        <p>Record marks, attendance, homework, notices and materials.</p>
    </div>
    <div class="card">
        <h2>Student Portal</h2>
        <p>View marks, timetable, attendance, homework and learning material.</p>
    </div>
    <div class="card">
        <h2>Admin Portal</h2>
        <p>Manage users, classes and POPIA audit information.</p>
    </div>
</div>
