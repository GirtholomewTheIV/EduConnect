@model MaterialViewModel

<h1>Add Course Material</h1>
<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="validation"></div>
    <div class="form-group"><label asp-for="Title"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="validation"></span></div>
    <div class="form-group"><label asp-for="SubjectId"></label><select asp-for="SubjectId" class="form-control" asp-items="@(new SelectList(ViewBag.Subjects, "SubjectId", "SubjectName"))"><option value="">Select Subject</option></select><span asp-validation-for="SubjectId" class="validation"></span></div>
    <div class="form-group"><label asp-for="Description"></label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="form-group"><label asp-for="File"></label><input asp-for="File" type="file" class="form-control" /><span asp-validation-for="File" class="validation"></span></div>
    <button type="submit" class="button">Upload</button>
    <a class="button secondary" asp-action="Index">Cancel</a>
</form>
