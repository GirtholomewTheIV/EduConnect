@model IEnumerable<CourseMaterial>

<div class="page-heading">
    <div>
        <h1>Course Materials</h1>
        <p class="lead">Learning resources uploaded by teachers.</p>
    </div>

    @if (User.IsInRole("Teacher"))
    {
        <a class="button" asp-action="Create">Add Material</a>
    }
</div>
  @if (TempData["Message"] is string message)
  {
    <div class="card" style="margin-bottom:16px">@message</div>
  }

<table class="table">
    <thead>
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>View</th>
            <th>Download</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Delete</th>
            }
        </tr>
    </thead>

    <tbody>

        @foreach (CourseMaterial item in Model)
        {
            <tr>
                <td>@item.Title</td>

                <td>@item.Description</td>

                <td>
                    <a class="button secondary"
                       asp-action="Open"
                       asp-route-id="@item.MaterialId"
                       target="_blank">
                        Open
                    </a>
                </td>
                <td>
                    <a class="button"
                       asp-action="Download"
                       asp-route-id="@item.MaterialId">
                        Download
                        </a>
                </td>
                @if (User.IsInRole("Admin"))
                  {
                    <td>
                        <form asp-action="Delete" asp-route-id="@item.MaterialId" method="post"
                              onsubmit="return confirm('Delete this material and its file? This cannot be undone.');">
                            <button type="submit" class="button" style="background:#b91c1c">Delete</button>
                        </form>
                    </td>
                }
            </tr>
        }

    </tbody>
</table>